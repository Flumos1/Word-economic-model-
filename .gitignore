# Python
__pycache__/
*.pyc

# Third-party raw data archives are never committed (licence_policy in protocols/evaluation_protocol_v4.json):
# files are retrieved automatically by tools/fetch_data.py in CI; only URL, retrieval date and SHA-256
# are recorded (protocols/data_log.json), never the files themselves.
/data/raw/
/data/external/
# Reconstructed early-PIT data root (tools/reconstruct_pit.py): derived from the raw archives, never committed.
/data/reconstructed/
GDPTrackingModelDataAndForecasts*.xlsx
GDPNowcastDataReleaseDates*.xlsx

# Secrets
.env

# local scratch (Lead runs)
.tmp-test/
# generated artefacts
build/*
!build/p2_release/
!build/p2_release/p2_release.json
!build/world/
build/world/*
!build/world/report_index.json
!build/world_oecd/
build/world_oecd/*
!build/world_oecd/report_index.json
!build/shadow/
build/shadow/*
!build/shadow/shadow_status.json
